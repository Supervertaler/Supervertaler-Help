---
/**
 * Custom Banner override for Starlight.
 *
 * Shows a product's status notice across its whole tree, keyed on the URL path -
 * the same pattern as Sidebar.astro (nav tree), Head.astro (search scope)
 * and Footer.astro (llms.txt subset). One file, rather than adding banner
 * frontmatter to 94 pages and having to remember it on every new one.
 *
 * A page in a product with no notice falls through to the default component, so
 * a per-page `banner:` in frontmatter still works everywhere else. A page
 * that sets its own banner inside a product that has one is deliberately
 * overridden: the status notice is the more important of the two.
 *
 * The notices themselves live in ../products.ts.
 *
 * Deliberately amber rather than Starlight's accent colour. This is a
 * status notice, not an announcement, and it should not read as a promo.
 */
import Default from '@astrojs/starlight/components/Banner.astro';
import { productFor } from '../products';

const route = Astro.locals.starlightRoute;
const id: string = route?.entry?.id ?? '';
const banner = productFor(id)?.banner ?? null;
---

{
  banner ? (
    <div class="sv-dormant-banner" set:html={banner} />
  ) : (
    <Default />
  )
}

<style>
  .sv-dormant-banner {
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: #fef3c7;
    color: #713f12;
    line-height: var(--sl-line-height-headings);
    text-align: center;
    text-wrap: balance;
    box-shadow: var(--sl-shadow-sm);
    font-size: var(--sl-text-sm);
  }

  .sv-dormant-banner a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  :global([data-theme='dark']) .sv-dormant-banner {
    background-color: #422006;
    color: #fde68a;
  }
</style>
