---
/**
 * Custom Banner override for Starlight.
 *
 * Shows a dormancy notice across /workbench/*, keyed on the URL path -
 * the same pattern as Sidebar.astro (nav tree), Head.astro (search scope)
 * and Footer.astro (llms.txt subset). One file, rather than adding banner
 * frontmatter to 94 pages and having to remember it on every new one.
 *
 * Any page outside /workbench/* falls through to the default component, so
 * a per-page `banner:` in frontmatter still works everywhere else. A
 * Workbench page that sets its own banner is deliberately overridden: the
 * dormancy notice is the more important of the two.
 *
 * Deliberately amber rather than Starlight's accent colour. This is a
 * status notice, not an announcement, and it should not read as a promo.
 */
import Default from '@astrojs/starlight/components/Banner.astro';

const route = Astro.locals.starlightRoute;
const id: string = route?.entry?.id ?? '';
const isWorkbench = id === 'workbench' || id.startsWith('workbench/');
---

{
  isWorkbench ? (
    <div class="sv-dormant-banner">
      <strong>Supervertaler Workbench is no longer actively developed.</strong> These pages stay
      online and still describe the last release. Active development is on{' '}
      <a href="/trados/">Supervertaler for Trados</a>.
    </div>
  ) : (
    <Default />
  )
}

<style>
  .sv-dormant-banner {
    padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
    background-color: #fef3c7;
    color: #713f12;
    line-height: var(--sl-line-height-headings);
    text-align: center;
    text-wrap: balance;
    box-shadow: var(--sl-shadow-sm);
    font-size: var(--sl-text-sm);
  }

  .sv-dormant-banner a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  :global([data-theme='dark']) .sv-dormant-banner {
    background-color: #422006;
    color: #fde68a;
  }
</style>
